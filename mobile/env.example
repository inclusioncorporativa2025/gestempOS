# Copiar a .env en esta carpeta (mobile/.env)
# Expo carga variables EXPO_PUBLIC_* al arrancar (reiniciar metro tras cambios).

# Emulador Android → localhost del PC:
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5000/api/

# Dispositivo físico en la misma red (sustituir por la IP de tu PC):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000/api/

# Producción:
# EXPO_PUBLIC_API_BASE_URL=https://app.timecor.es/api/
